---
/*
 * One glyph per service, drawn in the logo's own language: a hexagon shell
 * (the lattice) with a gold element inside (the sun). Inline SVG rather than
 * files — seven of these cost no requests, scale cleanly, and inherit colour
 * from the register they sit in.
 *
 * `navy` is currentColor so the glyph works on light and dark alike; the gold
 * is a fill on a shape, never text, so the gold rule holds in both.
 */
interface Props {
  name: string;
  class?: string;
}
const { name, class: className = '' } = Astro.props;

const HEX = 'M20 2.6 34.6 11v17.3L20 36.7 5.4 28.3V11z';
---

<svg
  class:list={['glyph', className]}
  viewBox="0 0 40 40"
  width="40"
  height="40"
  role="img"
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <path d={HEX} class="glyph__shell" />

  {name === 'software-development' && (
    <>
      <path d="M16.5 16.5 13 20l3.5 3.5" />
      <path d="M23.5 16.5 27 20l-3.5 3.5" />
      <circle cx="20" cy="20" r="1.6" class="glyph__gold" />
    </>
  )}

  {name === 'website-design-development' && (
    <>
      <rect x="12" y="14" width="16" height="12" rx="1.6" />
      <path d="M12 18h16" />
      <circle cx="14.6" cy="16" r="0.9" class="glyph__gold" />
    </>
  )}

  {name === 'ecommerce-solutions' && (
    <>
      <path d="M14 16h12l-1.2 9.5a1.4 1.4 0 0 1-1.4 1.2h-6.8a1.4 1.4 0 0 1-1.4-1.2z" />
      <path d="M17.2 16v-1.8a2.8 2.8 0 0 1 5.6 0V16" class="glyph__gold" />
    </>
  )}

  {name === 'digital-marketing' && (
    <>
      {/* the logo's rays, aimed outward — reach */}
      <circle cx="20" cy="20" r="3.2" class="glyph__gold" />
      <path d="M20 12.5v-2M20 29.5v-2M27.5 20h2M10.5 20h2M25.3 14.7l1.4-1.4M13.3 26.7l1.4-1.4M25.3 25.3l1.4 1.4M13.3 13.3l1.4 1.4" />
    </>
  )}

  {name === 'it-consulting' && (
    <>
      <path d="M14 15.5h12v8h-7l-3.4 2.8v-2.8H14z" />
      <path d="M18 19.5h4" class="glyph__gold" />
    </>
  )}

  {name === 'networking-infrastructure' && (
    <>
      {/* the logo's connected nodes */}
      <path d="M20 17v6M20 20l-4.6 3M20 20l4.6 3" />
      <circle cx="20" cy="15.4" r="1.8" class="glyph__gold" />
      <circle cx="14.6" cy="25" r="1.8" />
      <circle cx="25.4" cy="25" r="1.8" />
    </>
  )}

  {name === 'technology-products' && (
    <>
      <rect x="15.4" y="12.6" width="9.2" height="14.8" rx="1.8" />
      <path d="M18.6 24.6h2.8" class="glyph__gold" />
    </>
  )}
</svg>

<style>
  .glyph { flex-shrink: 0; }
  .glyph__shell { opacity: 0.28; }
  /* Gold as a stroked/filled shape, never as text — legible on either register. */
  .glyph__gold { stroke: var(--ra-gold-500); }
  circle.glyph__gold { fill: var(--ra-gold-500); stroke: var(--ra-gold-500); }
</style>
