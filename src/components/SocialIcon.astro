---
/*
 * Inline SVG marks, one path set per network. Inline because the JS budget
 * forbids an icon font and these are four small paths — a request each would
 * cost more than the markup does.
 *
 * currentColor throughout so the footer's hover rule tints them with the label.
 */
interface Props {
  network: 'linkedin' | 'facebook' | 'instagram' | 'x' | 'tiktok';
}
const { network } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  width="20"
  height="20"
  aria-hidden="true"
  focusable="false"
  fill="currentColor"
>
  {network === 'linkedin' && (
    <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm7 0h3.8v1.7h.05a4.16 4.16 0 0 1 3.75-2.06c4 0 4.75 2.64 4.75 6.07V21h-4v-5.4c0-1.29-.02-2.95-1.8-2.95-1.8 0-2.08 1.4-2.08 2.85V21h-4V9Z" />
  )}
  {network === 'facebook' && (
    <path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5 3.66 9.15 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.5-3.91 3.77-3.91 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.89h2.78l-.45 2.91h-2.33V22c4.78-.79 8.44-4.94 8.44-9.94Z" />
