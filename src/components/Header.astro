---
/*
 * Blog lives in the footer, not here. It earns its traffic from search rather
 * than from the primary nav, and dropping it keeps the bar short enough that
 * the CTA at the end reads as the one emphasised action.
 */
const links = [
  { href: '/services', label: 'Services' },
  { href: '/shop', label: 'Shop' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname;
---
<header class="hdr">
  <div class="ra-container hdr__inner">
    <a href="/" class="hdr__logo" aria-label="Radiant Alpha home">
      <img src="/images/logo-mark-96.png" alt="" width="36" height="36" />
      <span class="hdr__wordmark">Radiant Alpha</span>
    </a>

    <button
      class="hdr__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Menu"
    >
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M3 6h18M3 12h18M3 18h18" />
      </svg>
    </button>

    <nav id="primary-nav" class="hdr__nav" aria-label="Primary">
      <ul role="list">
        {links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>
              {label}
            </a>
          </li>
        ))}
        <li class="hdr__cart-item">
          <a href="/cart/" class="hdr__cart-link">
            Cart<span id="cart-badge" class="hdr__cart-badge" hidden>0</span>
          </a>
        </li>
        <li class="hdr__cta-item">
          <a href="/start-project" class="hdr__cta">Start Your Project</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  import { readCart, cartCount } from '../lib/client/cart';

  const toggle = document.querySelector<HTMLButtonElement>('.hdr__toggle');
  const nav = document.querySelector<HTMLElement>('#primary-nav');

  function setOpen(open: boolean) {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  function updateCartBadge() {
    const badge = document.getElementById('cart-badge');
    if (!badge) return;
    const count = cartCount(readCart(localStorage));
    badge.textContent = String(count);
    badge.hidden = count === 0;
  }

  updateCartBadge();
</script>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--ra-canvas);
    border-bottom: 1px solid var(--ra-border);
  }
  .hdr__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--ra-space-m);
    min-height: 68px;
  }
  .hdr__logo {
    display: flex;
    align-items: center;
    gap: var(--ra-space-xs);
    text-decoration: none;
  }
  .hdr__logo img { width: 36px; height: 36px; }
  .hdr__wordmark {
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ra-navy-600);
  }

  .hdr__toggle {
    display: grid;
    place-items: center;
    width: var(--ra-tap-min);
    height: var(--ra-tap-min);
    background: none;
    border: 0;
    border-radius: var(--ra-radius-s);
    color: var(--ra-navy-600);
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .hdr__toggle:hover {
    background: var(--ra-gold-500);
    color: var(--ra-navy-900);
  }

  .hdr__nav ul {
    display: flex;
    gap: var(--ra-space-l);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hdr__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--ra-tap-min);
    padding-inline: var(--ra-space-s);
    border-radius: var(--ra-radius-s);
    color: var(--ra-ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .hdr__nav a[aria-current='page'] { color: var(--ra-navy-600); }

  /*
   * The header sits on the light canvas, where gold text measures 1.87:1.
   * So the item turns gold and the label goes navy, rather than the reverse.
   */
  .hdr__nav a:hover {
    background: var(--ra-gold-500);
    color: var(--ra-navy-900);
  }

  /*
   * The one emphasised action in the bar. Gold fill with navy text — the same
   * pairing the hero CTA uses, and the only way gold is legible on the light
   * header. Because every other nav item turns gold on hover, this one darkens
   * instead: filling it gold again would leave hover indistinguishable.
   */
  .hdr__cta {
    background: var(--ra-gold-500);
    color: var(--ra-navy-900);
    font-weight: 700;
    padding-inline: var(--ra-space-l);
    border-radius: var(--ra-radius-m);
    white-space: nowrap;
  }
  .hdr__nav .hdr__cta:hover {
    background: var(--ra-navy-600);
    color: var(--ra-surface);
  }
  .hdr__nav .hdr__cta:active { background: var(--ra-navy-800); }
  .hdr__cta:focus-visible { outline-color: var(--ra-navy-900); }

  @media (min-width: 901px) {
    /* Sits off the end of the link run, not inside its rhythm. */
    .hdr__cta-item { margin-left: var(--ra-space-xs); }
  }

  @media (max-width: 900px) {
    .hdr__nav {
      display: none;
      position: absolute;
      inset-inline: 0;
      top: 100%;
      background: var(--ra-canvas);
      border-bottom: 1px solid var(--ra-border);
      padding: var(--ra-space-m) var(--ra-space-l) var(--ra-space-l);
    }
    .hdr__nav.is-open { display: block; }
    .hdr__nav ul { flex-direction: column; gap: 0; }
    .hdr__nav li + li { border-top: 1px solid var(--ra-border); }
    .hdr__nav a { width: 100%; }

    /* In the drawer it becomes a full-width button under a clear break. */
    .hdr__nav .hdr__cta-item {
      border-top: 0;
      margin-top: var(--ra-space-m);
    }
    .hdr__nav .hdr__cta { justify-content: center; }
  }

  @media (min-width: 901px) {
    .hdr__toggle { display: none; }
  }

  .hdr__cart-link {
    display: inline-flex;
    align-items: center;
    gap: var(--ra-space-2xs);
    min-height: var(--ra-tap-min);
    padding-inline: var(--ra-space-s);
    border-radius: var(--ra-radius-s);
    color: var(--ra-ink);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease;
  }
  .hdr__cart-link:hover {
    background: var(--ra-gold-500);
    color: var(--ra-navy-900);
  }
  .hdr__cart-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    height: 1.25rem;
    padding-inline: 0.25rem;
    border-radius: 999px;
    background: var(--ra-navy-600);
    color: var(--ra-surface);
    font-size: var(--ra-step--2);
    font-weight: 700;
  }
</style>
