---
interface Props {
  register?: 'light' | 'dark';
  as?: 'section' | 'div' | 'header' | 'footer';
  class?: string;
}
const { register = 'light', as: Tag = 'section', class: className = '' } = Astro.props;
---
<Tag class:list={['ra-section', register === 'dark' && 'ra-dark', className]}>
  <div class="ra-container">
    <slot />
  </div>
</Tag>

<style>
  /*
   * Band padding is a custom property rather than a fixed value so a page can
   * override it. A page's own `.hero`-style class lands on this element via the
   * `class` prop and so never carries that page's scope hash — a scoped rule
   * there matches nothing, and a :global one loses to this rule's specificity.
   * Setting the variable sidesteps both problems.
   */
  .ra-section {
    --_pad: var(--ra-section-pad, var(--ra-space-3xl));
    background: var(--ra-bg);
    color: var(--ra-fg);
    padding-block: var(--_pad);
  }
  @media (max-width: 640px) {
    .ra-section { --_pad: var(--ra-section-pad-sm, var(--ra-space-2xl)); }
  }
</style>
