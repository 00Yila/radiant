---
/*
 * Product imagery, per spec: "Designed placeholder cards: correct silhouette,
 * model name, storage, colourway, in navy and gold. Systematic rather than
 * improvised, so 53 of them read as a deliberate catalogue style rather than
 * 53 missing photographs."
 *
 * If a product sets `image`, that photograph is used instead — the swappable
 * slot the spec requires, so replacing one is a per-product edit.
 *
 * Deliberately NOT Apple's press renders. Those are licensed to authorised
 * channel partners under Apple's marketing guidelines; using them otherwise is
 * an infringement risk, and a pristine studio render of a *used* handset also
 * misrepresents the item. See CREDITS.md.
 */
interface Props {
  model: string;
  storage: string;
  generation: number;
  image?: string;
  imageAlt?: string;
  eager?: boolean;
  class?: string;
}
const {
  model,
  storage,
  generation,
  image,
  imageAlt,
  eager = false,
  class: className = '',
} = Astro.props;

// Silhouette follows the real hardware: a notch through the 11 series, the
// Dynamic Island from 14 Pro onward, and squarer rails from the 12 on.
const hasIsland = generation >= 14;
const hasNotch = generation >= 10 && generation < 14;
const radius = generation >= 12 ? 13 : 17;
const cameraCount = /Pro|Max/.test(model) && generation >= 11 ? 3 : 2;
---
{image ? (
  <img
    src={image}
    alt={imageAlt}
    class:list={['phone-photo', className]}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    width="600"
    height="600"
  />
) : (
  <svg
    class:list={['phone', className]}
    viewBox="0 0 200 200"
    role="img"
    aria-label={`Illustration of ${model}, ${storage}`}
  >
    <defs>
      <linearGradient id={`g-${storage}-${generation}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--ra-navy-700)" />
        <stop offset="1" stop-color="var(--ra-navy-900)" />
      </linearGradient>
    </defs>

    <rect width="200" height="200" rx="14" fill={`url(#g-${storage}-${generation})`} />

    {/* Handset body */}
    <rect
      x="66" y="34" width="68" height="132" rx={radius}
      fill="var(--ra-navy-800)" stroke="var(--ra-gold-500)" stroke-width="1.6"
    />
    <rect
      x="70" y="38" width="60" height="124" rx={radius - 3}
      fill="var(--ra-navy-900)" opacity="0.85"
    />

    {hasNotch && (
      <rect x="86" y="38" width="28" height="7" rx="3.5" fill="var(--ra-navy-700)" />
    )}
    {hasIsland && (
      <rect x="88" y="43" width="24" height="7" rx="3.5" fill="var(--ra-navy-700)" />
    )}

    {/* Camera cluster, top-left as on the real hardware */}
    <g fill="var(--ra-navy-700)" stroke="var(--ra-gold-500)" stroke-width="0.8">
      <circle cx="80" cy="56" r="4.4" />
      <circle cx="80" cy="68" r="4.4" />
      {cameraCount === 3 && <circle cx="91" cy="62" r="4.4" />}
    </g>

    {/* Storage badge — the one thing that differs between sibling listings */}
    <text
      x="100" y="150" text-anchor="middle"
      fill="var(--ra-gold-500)" font-size="13" font-weight="700"
      font-family="var(--ra-font-sans)" letter-spacing="0.5"
    >{storage}</text>
  </svg>
)}

<style>
  .phone, .phone-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--ra-radius-m);
  }
  .phone-photo { object-fit: cover; }
</style>
