---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import { buildWhatsAppUrl } from '../../lib/whatsapp';

const waUrl = buildWhatsAppUrl({
  message: "Hi Radiant Alpha, I can't find my order confirmation — can you help?",
});
---
<Base
  title="Order not found"
  description="We couldn't find that order reference."
  path="/order/not-found"
  noindex
>
  <Section register="dark">
    <p class="ra-eyebrow">Order not found</p>
    <h1 class="ra-display">We couldn&rsquo;t find that order.</h1>
    <p class="ra-lede">
      The reference in that link doesn&rsquo;t match anything on our side. If you have a
      confirmation email, use the reference from there — otherwise message us and we&rsquo;ll
      look it up.
    </p>
    <div class="ra-actions">
      <Button href="/track/" variant="gold">Try again</Button>
      <Button href={waUrl} variant="secondary" external>Message us on WhatsApp</Button>
    </div>
  </Section>
</Base>
