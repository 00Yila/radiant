---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import PhoneFigure from '../../components/PhoneFigure.astro';
import { formatNaira } from '../../lib/format';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import { SITE } from '../../lib/site';

const shop = (await getEntry('settings', 'site'))!.data;
const products = (await getCollection('products')).map((p) => p.data);

/*
 * One tile per model, not per configuration: a buyer is anchored on "iPhone 15
 * Pro Max", and splitting that across two tiles differing only in storage made
 * the grid longer without helping anyone choose. Storage is picked on the
 * product page instead. Newest generation first, cheapest model within it.
 */
const priceFrom = (p: (typeof products)[number]) =>
  Math.min(...p.variants.map((v) => v.price));

const sorted = [...products].sort(
  (a, b) => b.generation - a.generation || priceFrom(a) - priceFrom(b)
);

const groups = [
  { g: 17, name: 'iPhone 17 & Air', note: 'Current generation.' },
  { g: 16, name: 'iPhone 16', note: 'Previous generation.' },
  { g: 15, name: 'iPhone 15', note: 'Superseded twice.' },
  { g: 14, name: 'iPhone 14', note: '' },
  { g: 13, name: 'iPhone 13', note: '' },
  { g: 12, name: 'iPhone 12', note: '' },
  { g: 11, name: 'iPhone 11', note: '' },
  { g: 10, name: 'iPhone X, XR & XS', note: 'Discontinued from 2018.' },
]
  .map((group) => ({ ...group, items: sorted.filter((p) => p.generation === group.g) }))
  .filter((group) => group.items.length > 0);

const cheapest = Math.min(...products.flatMap((p) => p.variants.map((v) => v.price)));
const listingCount = products.reduce((n, p) => n + p.variants.length, 0);
const waUrl = buildWhatsAppUrl({
  message: "Hi Radiant Alpha, I'd like to ask about a device in your shop.",
});
---
<Base
  title="Shop"
  description={`${products.length} iPhone models — ${listingCount} configurations — on pre-order from Radiant Alpha, from ${formatNaira(cheapest)}. Condition, network lock and warranty stated before you order.`}
  path="/shop"
>
  <Section register="dark" class="ra-backdrop-photo shop-hero">
    <picture class="ra-backdrop__img">
      <source
        type="image/webp"
        srcset="/images/photos/products-iphone-640.webp 640w, /images/photos/products-iphone-1280.webp 1280w"
        sizes="100vw"
      />
      <img src="/images/photos/products-iphone-1280.jpg" width="1280" height="960" decoding="async" alt="" />
    </picture>
    <p class="ra-eyebrow">Shop · pre-order</p>
    <h1 class="ra-display">{products.length} iPhones, described honestly.</h1>
    <p class="ra-lede">
      {listingCount} configurations across {products.length} models, all supplied on
      pre-order — allow {shop.preOrderLeadTime} from order confirmation. Prices are
      what you pay; condition and network lock are stated before you order, not after
      the box is open.
    </p>
  </Section>

  {/*
    * The transparency promise, restated at the top of the catalogue. The home
    * page claims every listing states condition and lock status, so the shop
    * has to actually do it — including admitting what is not yet confirmed.
    */}
  <Section class="terms">
    <ul class="terms__list" role="list">
      <li>
        <p class="terms__k">{shop.preOrderLeadTime}</p>
        <p class="terms__v">From order confirmation to delivery</p>
      </li>
      <li>
        <p class="terms__k">{shop.inspectionWindowHours} hours</p>
        <p class="terms__v">To report damage or a wrong item</p>
      </li>
      <li>
        <p class="terms__k">{shop.warrantyDays} days</p>
        <p class="terms__v">Defect warranty on hardware faults</p>
      </li>
      <li>
        <p class="terms__k">{shop.networkLock}</p>
        <p class="terms__v">Confirmed in writing before you pay</p>
      </li>
    </ul>

    {!shop.conditionConfirmed && (
      <p class="terms__pending">
        <strong>On condition:</strong> each listing states whether the model can be
        new, based on when Apple discontinued it. The exact grade, battery health and
        SIM type of the specific handset are confirmed with you in writing before any
        payment — we would rather say so than print a number we have not verified.
      </p>
    )}
  </Section>

  {groups.map(({ g, name, note, items }) => (
    <Section class="grp">
      <div class="grp__head">
        <h2 id={`gen-${g}`}>{name}</h2>
        <p class="grp__count ra-numeric">
          {items.length} {items.length === 1 ? 'model' : 'models'}
          {note && <span class="grp__note"> · {note}</span>}
        </p>
      </div>

      <ul class="grid" role="list" aria-labelledby={`gen-${g}`}>
        {items.map((p) => (
          <li class="ra-card tile">
            <PhoneFigure
              model={p.model}
              storage={p.variants[0].storage}
              generation={p.generation}
              image={p.image}
              imageAlt={p.imageAlt}
              class="tile__img"
            />
            <h3><a href={`/shop/${p.id}`}>{p.model}</a></h3>
            <p class="tile__storage">
              {p.variants.map((v) => v.storage).join(' · ')} · {p.conditionLabel}
            </p>
            <p class="tile__price ra-numeric">
              {p.variants.length > 1 && <span class="tile__from">From </span>}
              {formatNaira(priceFrom(p))}
            </p>
          </li>
        ))}
      </ul>
    </Section>
  ))}

  <Section register="dark" class="ra-backdrop-nodes">
    <h2 class="ra-display">Not sure which model?</h2>
    <p class="ra-lede">
      Tell us your budget and what you use a phone for, and we will tell you which of
      these is the sensible buy — including when the cheaper one is.
    </p>
    <Button href={waUrl} variant="gold" external>Ask on WhatsApp</Button>
  </Section>
</Base>

<style>
  .terms__list {
    display: grid;
    gap: var(--ra-space-l);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) { .terms__list { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .terms__list { grid-template-columns: repeat(4, 1fr); } }
  .terms__k {
    font-weight: 700;
    font-size: var(--ra-step-1);
    color: var(--ra-gold-ink);
  }
  .terms__v { color: var(--ra-fg-muted); font-size: var(--ra-step--1); margin-top: 2px; }
  .terms__pending {
    margin-top: var(--ra-space-xl);
    padding: var(--ra-space-m) var(--ra-space-l);
    border-left: 3px solid var(--ra-gold-500);
    border-radius: 0 var(--ra-radius-s) var(--ra-radius-s) 0;
    background: var(--ra-navy-50);
    max-width: 78ch;
    font-size: var(--ra-step--1);
  }

  /* Groups sit closer together than full sections — one continuous catalogue. */
  .grp { padding-block: var(--ra-space-xl); }
  .grp__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--ra-space-s) var(--ra-space-m);
    padding-bottom: var(--ra-space-s);
    border-bottom: 1px solid var(--ra-border);
  }
  .grp__head h2 { font-size: var(--ra-step-2); }
  .grp__count { color: var(--ra-fg-muted); font-size: var(--ra-step--1); }
  .grp__note { color: var(--ra-fg-muted); }

  .grid {
    display: grid;
    gap: var(--ra-space-l);
    margin-top: var(--ra-space-l);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
  }
  .tile { display: flex; flex-direction: column; }
  .tile__img { margin-bottom: var(--ra-space-m); }
  .tile h3 { font-size: var(--ra-step-0); }
  .tile h3 a { text-decoration: none; }
  .tile h3 a:hover { text-decoration: underline; }
  .tile__storage {
    color: var(--ra-fg-muted);
    font-size: var(--ra-step--1);
    margin-top: 2px;
  }
  .tile__from { font-weight: 400; color: var(--ra-fg-muted); font-size: var(--ra-step--1); }
  .tile__price {
    margin-top: auto;
    padding-top: var(--ra-space-m);
    font-weight: 700;
    color: var(--ra-navy-600);
  }
</style>
