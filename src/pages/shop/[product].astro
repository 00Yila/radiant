---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import Button from '../../components/Button.astro';
import ProductFigure from '../../components/ProductFigure.astro';
import { formatNaira } from '../../lib/format';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import { SITE } from '../../lib/site';
import { priceFrom, specRows, isEsimRisk, isDiscontinued, CATEGORY_LABELS } from '../../lib/catalogue';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((entry) => ({
    params: { product: entry.data.id },
    props: { product: entry.data },
  }));
}

const { product } = Astro.props;
const shop = (await getEntry('settings', 'site'))!.data;

const all = (await getCollection('products')).map((p) => p.data);

const similar = all
  .filter((p) => p.category === product.category && p.id !== product.id)
  .sort((a, b) => priceFrom(a) - priceFrom(b))
  .slice(0, 4);

const variants = product.variants;
const cheapest = priceFrom(product);

/*
 * Each configuration gets its own pre-written order message carrying the exact
 * variant, price, reference and lead time, so neither side can later disagree
 * about what was ordered — this link is the whole revenue mechanism.
 */
const buy = variants.map((v) => ({
  ...v,
  waUrl: buildWhatsAppUrl({
    message: [
      `Hi Radiant Alpha, I'd like to pre-order:`,
      `${product.brand} ${product.model} — ${v.label}${v.colour ? ` — ${v.colour}` : ''} — ${formatNaira(v.price)}`,
      `Ref: ${v.ref}`,
      `I understand delivery is ${shop.preOrderLeadTime} from order confirmation.`,
    ].join('\n'),
  }),
}));

const eSimCaution = isEsimRisk(product);
const rows = specRows(product, shop);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProductGroup',
  name: product.model,
  brand: { '@type': 'Brand', name: product.brand },
  category: product.category,
  productGroupID: product.id,
  variesBy: ['https://schema.org/size'],
  hasVariant: variants.map((v) => ({
    '@type': 'Product',
    name: `${product.model} ${v.label}`,
    sku: v.ref,
    size: v.label,
    offers: {
      '@type': 'Offer',
      price: v.price,
      priceCurrency: 'NGN',
      availability: 'https://schema.org/PreOrder',
      url: new URL(`/shop/${product.id}`, SITE.domain).href,
      seller: { '@type': 'Organization', name: SITE.legalName },
    },
  })),
};

const crumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.domain },
    { '@type': 'ListItem', position: 2, name: 'Shop', item: new URL('/shop', SITE.domain).href },
    { '@type': 'ListItem', position: 3, name: product.model },
  ],
};

const variantList = variants.map((v) => v.label).join(', ');
---
<Base
  title={product.model}
  description={`${product.brand} ${product.model} on pre-order from ${formatNaira(cheapest)} — ${variantList}. ${product.conditionLabel}. Delivery ${shop.preOrderLeadTime} from confirmation.`}
  path={`/shop/${product.id}`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbSchema)} />
  </Fragment>

  <Section>
    <nav class="ra-crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/shop">Shop</a></li>
        <li aria-current="page">{product.model}</li>
      </ol>
    </nav>

    <div class="pdp">
      <div class="pdp__media">
        <ProductFigure
          category={product.category}
          model={product.model}
          badge={variants[0].label}
          appleGeneration={product.appleGeneration}
          image={product.image}
          imageAlt={product.imageAlt}
          eager
        />
        {!product.image && (
          <p class="pdp__imgnote">
            This is a drawing of the model, not a photo of the phone itself. Before it
            ships, we send you real photos of the exact one you will get.
          </p>
        )}
      </div>

      <div class="pdp__detail">
        <p class="pdp__brand">{product.brand}</p>
        <h1 class="pdp__title">{product.model}</h1>
        <p class="pdp__cond">{product.conditionLabel}</p>

        {/*
          * Radios plus CSS sibling selectors, so choosing a configuration needs
          * no JavaScript at all. Each panel carries its own price, reference
          * and pre-written WhatsApp link; only the checked one is shown.
          */}
        <div class="buy">
          {buy.map((v, i) => (
            <input
              class="buy__radio"
              type="radio"
              name="variant"
              id={`v-${i}`}
              checked={i === 0}
            />
          ))}

          {variants.length > 1 && (
            <fieldset class="buy__chips">
              <legend>{product.variantAxis}</legend>
              {buy.map((v, i) => (
                <label for={`v-${i}`}>{v.label}</label>
              ))}
            </fieldset>
          )}

          <div class="buy__panels">
            {buy.map((v) => (
              <div class="buy__panel">
                <p class="buy__price ra-numeric">{formatNaira(v.price)}</p>
                <p class="buy__ref">
                  {v.label}{v.colour ? ` · ${v.colour}` : ''} · Order code {v.ref}
                </p>

                <p class="pdp__notice">
                  <strong>We order this in for you.</strong> It reaches you about
                  {' '}{shop.preOrderLeadTime} after we confirm your order.
                </p>

                <form method="post" action="/checkout.php" class="buy__form">
                  <input type="hidden" name="product" value={product.id} />
                  <input type="hidden" name="variant" value={v.ref} />

                  {/* Same honeypot idiom as contact.astro — see that file for why
                      aria-hidden and tabindex="-1" are both needed. IDs are
                      namespaced per variant since several panels share one page. */}
                  <p class="ra-visually-hidden" aria-hidden="true">
                    <label for={`bot-field-${v.ref}`}>Leave this field empty</label>
                    <input id={`bot-field-${v.ref}`} name="bot-field" tabindex="-1" autocomplete="off" />
                  </p>

                  <div class="buy__field">
                    <label for={`name-${v.ref}`}>Your name</label>
                    <input id={`name-${v.ref}`} name="name" type="text" required autocomplete="name" maxlength="120" />
                  </div>
                  <div class="buy__field">
                    <label for={`email-${v.ref}`}>Email address</label>
                    <input
                      id={`email-${v.ref}`}
                      name="email"
                      type="email"
                      required
                      autocomplete="email"
                      pattern="[^\s@]+@[^\s@]+\.[^\s@]+"
                    />
                  </div>
                  <div class="buy__field">
                    <label for={`phone-${v.ref}`}>Phone or WhatsApp number</label>
                    <input id={`phone-${v.ref}`} name="phone" type="tel" required autocomplete="tel" maxlength="40" />
                  </div>

                  <Button as="button" type="submit" variant="gold">
                    Pay {formatNaira(v.price)} now
                  </Button>
                  <p class="buy__note">
                    You&rsquo;ll pay on Paystack&rsquo;s own secure page — we never see your
                    card details — then get a confirmation and a tracking link.
                  </p>
                </form>

                <p class="buy__divider"><span>or</span></p>

                {/* The pre-payment path, for anyone who wants the exact battery,
                    colour confirmed before committing money. Nothing is charged
                    by pressing this — it only opens WhatsApp with the order
                    details drafted in. */}
                <Button href={v.waUrl} variant="secondary" external>
                  Ask on WhatsApp first
                </Button>
                <p class="buy__note">
                  Want the exact battery and colour confirmed before you pay? Message us
                  here first — no payment yet.
                </p>
              </div>
            ))}
          </div>
        </div>

        <dl class="pdp__specs">
          {rows.map(({ label, value }) => (
            <div><dt>{label}</dt><dd>{value}</dd></div>
          ))}
        </dl>

        <p class="pdp__notice pdp__notice--repeat">
          {shop.inspectionWindowHours} hours to reject a damaged or wrong phone for a full
          refund · {shop.warrantyDays}-day fault warranty ·{' '}
          <a href="/returns">Read the full returns and warranty terms</a>
        </p>
      </div>
    </div>
  </Section>

  <Section class="ra-backdrop-hex">
    <div class="honest ra-measure">
      <h2>What&rsquo;s confirmed, and when</h2>
      <p>
        In this trade, sellers usually stay quiet about condition until the box is
        already open and the money is gone. We do it differently: everything a listing
        can tell you upfront, it does — before you ever pay. What only the specific
        phone we send you can answer, we confirm in writing before it ships, and back
        with a {shop.inspectionWindowHours}-hour inspection window: a full refund or
        replacement if it isn&rsquo;t as described.
      </p>
      <ul>
        <li>
          <strong>Is this phone new?</strong>{' '}
          {isDiscontinued(product) ? (
            'No — Apple stopped making this model, so nobody, including us, can sell it brand new. This one is used or refurbished, as stated on this listing.'
          ) : product.conditionTier === 'new' ? (
            'Yes — brand new and sealed.'
          ) : (
            `${product.conditionLabel}. We confirm the exact grade before dispatch, backed by our ${shop.inspectionWindowHours}-hour inspection window.`
          )}
        </li>
        <li>
          {/* "New / Grade A / Grade B" is the site's own grading vocabulary —
              see the shop page — not invented for this bullet. */}
          <strong>The condition and colour of the actual phone</strong> you are
          buying, not the model in general — graded New, Grade A (excellent,
          minimal wear) or Grade B (light wear, fully working){product.category === 'phones' && ', plus its battery health'}.
          We confirm this in writing, with photographs, before your order ships — and
          if it doesn&rsquo;t match, our {shop.inspectionWindowHours}-hour inspection
          window covers a full refund or replacement.
        </li>
        {eSimCaution && (
          <li>
            <strong>Will your SIM card fit?</strong> Some units of this model were made
            for the American market with no SIM card slot at all — the line has to be
            set up digitally instead, and MTN, Airtel, Glo and 9mobile do not all
            support that reliably yet. We check the actual phone and confirm which kind
            it is before dispatch, covered by the same inspection window if we get it
            wrong.
          </li>
        )}
        <li>
          <strong>What the warranty does not cover.</strong> The {shop.warrantyDays}-day
          warranty covers faults in the phone itself. It never covers damage you cause —
          drops, cracks, water — and on any phone that is not brand new, it does not
          cover normal wear or a battery that has weakened with age.
        </li>
      </ul>
    </div>
  </Section>

  {similar.length > 0 && (
    <Section>
      {/* "More in this category" was website-structure language; naming the
          actual category ("More phones we stock") reads as a shop, not a CMS. */}
      <h2>More {CATEGORY_LABELS[product.category].label.toLowerCase()} we stock</h2>
      <ul class="rail" role="list">
        {similar.map((p) => (
          <li class="ra-card">
            <h3><a href={`/shop/${p.id}`}>{p.brand} {p.model}</a></h3>
            <p class="rail__price ra-numeric">
              {p.variants.length > 1 && <span class="rail__from">From </span>}
              {formatNaira(priceFrom(p))}
            </p>
          </li>
        ))}
      </ul>
    </Section>
  )}
</Base>

<style>
  .pdp { display: grid; gap: var(--ra-space-xl); }
  @media (min-width: 820px) {
    .pdp { grid-template-columns: 1fr 1fr; gap: var(--ra-space-3xl); align-items: start; }
  }
  .pdp__imgnote {
    margin-top: var(--ra-space-s);
    font-size: var(--ra-step--1);
    color: var(--ra-fg-muted);
  }
  .pdp__brand {
    font-size: var(--ra-step--1);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ra-gold-ink);
  }
  .pdp__title { font-size: var(--ra-step-3); margin-top: 2px; }
  .pdp__cond { color: var(--ra-fg-muted); margin-top: var(--ra-space-2xs); }

  /* ---- variant picker: radios drive everything, no script ---- */
  .buy { margin-top: var(--ra-space-l); }
  /* Off-screen rather than display:none, so they stay keyboard-focusable. */
  .buy__radio {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .buy__chips {
    border: 0;
    padding: 0;
    margin: 0 0 var(--ra-space-l);
    display: flex;
    flex-wrap: wrap;
    gap: var(--ra-space-xs);
  }
  .buy__chips legend {
    font-size: var(--ra-step--1);
    font-weight: 600;
    color: var(--ra-fg-muted);
    margin-bottom: var(--ra-space-xs);
  }
  .buy__chips label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--ra-tap-min);
    min-width: 5.5rem;
    padding-inline: var(--ra-space-m);
    border-radius: var(--ra-radius-m);
    box-shadow: inset 0 0 0 1.5px var(--ra-border);
    font-weight: 600;
    cursor: pointer;
    transition: background-color 160ms ease, color 160ms ease, box-shadow 160ms ease;
  }
  .buy__chips label:hover {
    background: var(--ra-gold-500);
    color: var(--ra-navy-900);
    box-shadow: inset 0 0 0 1.5px var(--ra-gold-500);
  }

  .buy__panel { display: none; }

  /*
   * One pair of rules per position. Four covers the catalogue — the widest
   * model offers three storage sizes — and catalogue.test.ts fails if any
   * model ever exceeds four, which would otherwise leave a panel unreachable.
   */
  .buy__radio:nth-of-type(1):checked ~ .buy__panels .buy__panel:nth-child(1),
  .buy__radio:nth-of-type(2):checked ~ .buy__panels .buy__panel:nth-child(2),
  .buy__radio:nth-of-type(3):checked ~ .buy__panels .buy__panel:nth-child(3),
  .buy__radio:nth-of-type(4):checked ~ .buy__panels .buy__panel:nth-child(4) {
    display: block;
  }

  .buy__radio:nth-of-type(1):checked ~ .buy__chips label:nth-of-type(1),
  .buy__radio:nth-of-type(2):checked ~ .buy__chips label:nth-of-type(2),
  .buy__radio:nth-of-type(3):checked ~ .buy__chips label:nth-of-type(3),
  .buy__radio:nth-of-type(4):checked ~ .buy__chips label:nth-of-type(4) {
    background: var(--ra-navy-600);
    color: var(--ra-surface);
    box-shadow: inset 0 0 0 1.5px var(--ra-navy-600);
  }

  /* The radio is off-screen, so its focus ring has to land on the label. */
  .buy__radio:nth-of-type(1):focus-visible ~ .buy__chips label:nth-of-type(1),
  .buy__radio:nth-of-type(2):focus-visible ~ .buy__chips label:nth-of-type(2),
  .buy__radio:nth-of-type(3):focus-visible ~ .buy__chips label:nth-of-type(3),
  .buy__radio:nth-of-type(4):focus-visible ~ .buy__chips label:nth-of-type(4) {
    outline: 3px solid var(--ra-gold-500);
    outline-offset: 2px;
  }

  .buy__price {
    font-size: var(--ra-step-3);
    font-weight: 700;
    color: var(--ra-navy-600);
  }
  .buy__ref {
    color: var(--ra-fg-muted);
    font-size: var(--ra-step--1);
    margin-bottom: var(--ra-space-m);
  }
  .buy__note {
    margin-top: var(--ra-space-xs);
    color: var(--ra-fg-muted);
    font-size: var(--ra-step--1);
  }

  .buy__form {
    display: grid;
    gap: var(--ra-space-s);
    margin-bottom: var(--ra-space-m);
  }
  .buy__field { display: grid; gap: var(--ra-space-2xs); }
  .buy__field label { font-weight: 600; font-size: var(--ra-step--1); }
  .buy__field input {
    min-height: var(--ra-tap-min);
    padding: var(--ra-space-s) var(--ra-space-m);
    border: 1px solid var(--ra-border);
    border-radius: var(--ra-radius-s);
    background: var(--ra-surface);
  }

  /* A short rule either side of "or", not a bare word — reads as a genuine
     fork between two ways to buy rather than a leftover label. */
  .buy__divider {
    display: flex;
    align-items: center;
    gap: var(--ra-space-s);
    margin-block: var(--ra-space-m);
    color: var(--ra-fg-muted);
    font-size: var(--ra-step--1);
  }
  .buy__divider::before,
  .buy__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--ra-rule);
  }

  /*
   * A tinted panel with a hairline all the way round, rather than a thick bar
   * down one edge. The bold lead-in in gold ink is what marks this as a notice;
   * gold-500 would be 1.8:1 here, so the darker ink does that job.
   */
  .pdp__notice {
    background: var(--ra-navy-50);
    border: 1px solid rgb(239 180 46 / 0.4);
    border-radius: var(--ra-radius-s);
    padding: var(--ra-space-s) var(--ra-space-m);
    font-size: var(--ra-step--1);
    margin-bottom: var(--ra-space-l);
  }
  .pdp__notice strong { color: var(--ra-gold-ink); }
  .pdp__notice--repeat { margin-top: var(--ra-space-l); margin-bottom: 0; }

  .pdp__specs {
    display: grid;
    gap: var(--ra-space-xs);
    margin-top: var(--ra-space-xl);
    padding-block: var(--ra-space-m);
    border-block: 1px solid var(--ra-rule);
  }
  .pdp__specs > div { display: flex; justify-content: space-between; gap: var(--ra-space-m); }
  .pdp__specs dt { color: var(--ra-fg-muted); font-size: var(--ra-step--1); }
  .pdp__specs dd { font-weight: 600; text-align: right; }

  .honest h2 { font-size: var(--ra-step-2); }
  .honest p { color: var(--ra-fg-muted); margin-top: var(--ra-space-m); }
  .honest ul { margin-top: var(--ra-space-m); padding-left: 1.2em; }
  .honest li { margin-top: var(--ra-space-s); color: var(--ra-fg-muted); }

  .rail {
    display: grid;
    gap: var(--ra-space-m);
    margin-top: var(--ra-space-l);
    padding: 0;
    list-style: none;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  }
  .rail h3 { font-size: var(--ra-step-0); }
  .rail h3 a { text-decoration: none; }
  .rail h3 a:hover { text-decoration: underline; }
  .rail__from { font-weight: 400; color: var(--ra-fg-muted); font-size: var(--ra-step--1); }
  .rail__price { margin-top: var(--ra-space-xs); font-weight: 700; color: var(--ra-navy-600); }
</style>
